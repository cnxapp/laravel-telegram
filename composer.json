{
    "name": "cnxapp/laravel-telegram",
    "description": "Typed Telegram Bot API client and DTOs for Laravel",
    "keywords": [
        "cnxapp",
        "telegram",
        "laravel-telegram"
    ],
    "homepage": "https://github.com/cnxapp/laravel-telegram",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Cnx\\LaravelTelegram\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Volodymyr Bespalov",
            "email": "laravel-telegram@vab.com.ua"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.9.2"
    },
    "require-dev": {
        "ext-dom": "*",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Cnx\\LaravelTelegram\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cnx\\LaravelTelegram\\TelegramServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "@php vendor/bin/pint",
        "format:check": "@php vendor/bin/pint --test",
        "generate:bot-api": [
            "@php tools/generate-bot-api.php",
            "@php vendor/bin/pint --quiet src/BotApi/Generated src/Facades/BotApi.php"
        ],
        "test": "@php vendor/bin/phpunit",
        "qa": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "support": {
        "issues": "https://github.com/cnxapp/laravel-telegram/issues",
        "source": "https://github.com/cnxapp/laravel-telegram"
    }
}
